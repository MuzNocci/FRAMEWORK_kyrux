# Environment
.env
.env copy

# Development
.claude
.vscode

# Build
/bin/
/kyrux
/kyrux_bench
/benchmark/
/tmp/
/core/air/tmp/
/core/air/apps/*
!/core/air/apps/.gitkeep
/apps/*
!/apps/.gitkeep
# meta é o único app que o framework em si traz pronto (robots.txt/
# sitemap.xml/security.txt) — todo o resto de /apps é específico de cada
# projeto clonado a partir deste template, por isso continua ignorado.
!/apps/meta
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test
*.test
*.out
coverage.html
coverage.out
pprof_mem_top.txt
gc_escapes.txt

# Go workspace
go.work
go.work.sum

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Media uploads (user-generated content — use external storage in production)
/medias/*
!/medias/.gitkeep

# Database — migrations locais e o SQLite de fallback do admin
# (database/kyrux.sqlite3, criado automaticamente só em development quando
# ADMIN_ENABLED=true e nenhum banco está configurado)
/database/*
/database/

# Notas internas de benchmark — comparativo pontual, não é documentação
# oficial do sistema (essa fica em README.md/USE.md)
/BENCHMARK.md
