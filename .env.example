# Enviroment
# development → debug automático ligado
# production → debug automático desligado
APP_ENV=development

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# SERVER_WORKERS=4  # Omita (recomendado): o runtime Go usa todos os CPUs.
#                   # Defina apenas para LIMITAR o uso de CPU do processo.

ALLOWED_HOSTS=0.0.0.0,localhost,127.0.0.1

# Database — cada bloco iniciado por DB_NAME define um banco.
# O primeiro bloco é o padrão (fw.DB.Use() / orm.From com "default").
# Para apps sem banco: remova (ou desabilite) todos os blocos.
DB_ENABLED=false
DB_NAME=default
DB_DRIVER=postgres
DB_DSN=postgres://user:password@localhost:5432/kyrux?sslmode=disable

# DB_NAME=analytics          # adicione quantos blocos precisar
# DB_ENABLED=true
# DB_DRIVER=postgres
# DB_DSN=postgres://user:password@localhost:5432/analytics?sslmode=disable

# Cache — armazenamento chave/valor com TTL
CACHE_ENABLED=false
CACHE_DRIVER=memory          # memory | redis (roadmap — hoje roda em memória)
CACHE_ADDR=localhost:6379    # endereço do broker quando driver != memory

# Queue — fila de tarefas em background (workers, retry, drenagem no shutdown)
# Diferente do cache (armazenamento) e do EventBus (pub/sub): cada tarefa
# é processada por UM worker, com retry em caso de falha.
QUEUE_ENABLED=false
QUEUE_DRIVER=memory          # memory | redis (roadmap — hoje roda em memória)
QUEUE_ADDR=localhost:6379    # endereço do broker quando driver != memory
QUEUE_WORKERS=4

# Security
SECRET_KEY=your-strong-random-secret-key-here
SESSION_TTL=3600

# Pepper aplicado antes do hash Argon2id — nunca armazenar no banco.
# Gere com: openssl rand -base64 32
PASSWORD_PEPPER=your-strong-random-pepper-here

# Chave usada para criptografia de campos kyrux:"encrypt" (AES-256-GCM).
# Gere com: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=your-base64-32-byte-key-here

# Admin — painel de administração opt-in por model (admin.Register[T] no
# Register() do app). Sem nenhum model registrado, /admin/ nem é montado,
# mesmo com ADMIN_ENABLED=true.
ADMIN_ENABLED=false
ADMIN_PATH=/admin/    # renomear dificulta descoberta automática por scanners

# Opcional — cria o superusuário principal no boot, se ainda não existir
# ninguém com esse login (username ou email, conforme kyrux:"login" em
# auth.User). NÃO redefine a senha de uma conta já existente — seguro deixar
# definido entre reinícios. Deixe vazio (padrão) para criar via
# `go run main.go createsuperuser` em vez disso.
# ADMIN_SUPERUSER_USERNAME=admin
# ADMIN_SUPERUSER_PASSWORD=troque-esta-senha-provisoria

# Proxy reverso (opcional) — nome do header com o IP real do cliente.
# Só defina se estiver atrás de um proxy que SOBRESCREVE este header
# (nginx/Caddy). Sem isso, o RateLimit usa o IP da conexão (RemoteAddr).
# TRUSTED_PROXY_HEADER=X-Forwarded-For

# Runtime (opcional)
# RUNTIME_GOGC=75            # GC percentage (padrão Go: 100)
# RUNTIME_GOMEMLIMIT=512MiB  # teto de memória do GC — recomendado em containers
